# Copy to .env and replace every required value. Do not commit .env.
FEISHU_APP_ID=YOUR_FEISHU_APP_ID
FEISHU_APP_SECRET=YOUR_FEISHU_APP_SECRET
FEISHU_CHAT_ID=YOUR_FEISHU_GROUP_CHAT_ID
FEISHU_OWNER_OPEN_ID=YOUR_FEISHU_OWNER_OPEN_ID

# Defaults match the original scheduler and model; choose a model your account can use.
MYCLAW_CODEX_MODEL=gpt-5.6-sol
MYCLAW_TIMEZONE=Asia/Shanghai
MYCLAW_GATEWAY_PORT=15110
# Optional absolute paths. Defaults are derived from the installing user's home.
# MYCLAW_WORKSPACE=/absolute/path/to/workspace
# MYCLAW_STATE_DIR=/absolute/path/to/openclaw-state
# MYCLAW_CODEX_BIN=/absolute/path/to/codex
# MYCLAW_PYTHON_BIN=/absolute/path/to/python3
